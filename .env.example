# EasyParking-ийн олгосон X-API-Key (орчин бүрд тусдаа — TEST-ийнх PROD-д ажиллахгүй).
# Зөвхөн backend-д хадгална.
EASYPARKING_API_KEY=

# test | production (хоосон бол test)
#   test       → https://test.easy-parking.mn/api/v1
#   production → https://site.easy-parking.mn/api/v1
EASYPARKING_ENVIRONMENT=test

# Сонголттой: proxy г.м-ээр дамжуулах бол бүтэн URL (…/api/v1 хүртэл). Хоосон бол environment-ээс.
EASYPARKING_BASE_URL=
